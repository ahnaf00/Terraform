# Local .terraform directories (provider binaries, modules)
**/.terraform/*

# State files (can contain secrets)
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Override files (local-only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plan files
*.tfplan
tfplan

# CLI config
.terraformrc
terraform.rc

# OS / editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Note: .terraform.lock.hcl is intentionally NOT ignored — commit it
# so everyone uses the same provider versions.
